# Day 1 environment variables. See documents/API.md section 11 for the full
# list of variables introduced in later phases (R2, PostHog, email,
# payments) — do not add them here until those integrations land.

# Public Convex deployment URL used by the browser client. vinext only
# inlines NEXT_PUBLIC_* vars for the client bundle (it mirrors Next.js'
# convention, not Vite's import.meta.env.VITE_* convention) — but `npx
# convex dev` detects this as a Vite project and writes VITE_CONVEX_URL /
# VITE_CONVEX_SITE_URL to .env.local instead. Mirror the value into
# NEXT_PUBLIC_CONVEX_URL and NEXT_PUBLIC_CONVEX_SITE_URL by hand (or re-run
# `npx convex dev` after this ships upstream) until that detection is fixed.
# dev/staging/production are separate Convex deployments, per
# ARCHITECTURE.md section 3.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# The app's own origin. Used by the Better Auth client/server wiring
# (src/lib/auth/client.ts, src/lib/auth/server.ts) for callback and cookie
# scoping — set it to the real deployed origin outside local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:5173

# Written by `npx convex dev` for this Vite-detected project; same values as
# the NEXT_PUBLIC_CONVEX_* pair above. Not read directly by application code.
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Convex CLI deployment identifier, written by `npx convex dev` /
# `npx convex deploy`. Not read by application code directly.
CONVEX_DEPLOYMENT=

# Set on the Convex deployment itself, not here — `npx convex env set
# BETTER_AUTH_SECRET ...` and `npx convex env set SITE_URL ...`
# (convex/auth.ts). Listed for awareness only; this file documents the
# browser/Worker-side variables, not Convex deployment variables.

# `/admin` is staff-auth-gated, not build-excluded (src/app/admin/layout.tsx,
# convex/staff.ts) — there is no CMS_PREVIEW flag anymore. Reaching the CMS
# in any environment requires a real Better Auth session with an active
# `staffMemberships` row; see docs/DAY6_ADMIN_CMS.md section 1 for what that
# replaced and why.
