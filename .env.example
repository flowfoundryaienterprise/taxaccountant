# Day 1 environment variables. See documents/API.md section 11 for the full
# list of variables introduced in later phases (Better Auth, R2, PostHog,
# email, payments) — do not add them here until those integrations land.

# Public Convex deployment URL used by the browser client. vinext only
# inlines NEXT_PUBLIC_* vars for the client bundle (it mirrors Next.js'
# convention, not Vite's import.meta.env.VITE_* convention) — but `npx
# convex dev` detects this as a Vite project and writes VITE_CONVEX_URL /
# VITE_CONVEX_SITE_URL to .env.local instead. Mirror the value into
# NEXT_PUBLIC_CONVEX_URL by hand (or re-run `npx convex dev` after this
# ships upstream) until that detection is fixed. dev/staging/production are
# separate Convex deployments, per ARCHITECTURE.md section 3.
NEXT_PUBLIC_CONVEX_URL=

# Written by `npx convex dev` for this Vite-detected project; same value as
# NEXT_PUBLIC_CONVEX_URL above. Not read directly by application code.
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Convex CLI deployment identifier, written by `npx convex dev` /
# `npx convex deploy`. Not read by application code directly.
CONVEX_DEPLOYMENT=

# Day 6: opens the Phase 1 CMS at /admin for local development.
#
# Read by `vite.config.ts` (which runs in Node and can see the real shell
# environment) — NOT by application code. When it is unset, the
# `cms-production-exclusion` plugin replaces every module under
# `src/app/admin/` with a notFound() stub, so no CMS code or fixture data
# is compiled into the build and /admin returns 404.
#
# Never set this for a deployed build. The CMS has no authentication; the
# build gate is the only thing keeping it off the public internet. See
# docs/DAY6_ADMIN_CMS.md section 1.
#
CMS_PREVIEW=enabled npm run dev
