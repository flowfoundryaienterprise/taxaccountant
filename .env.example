# Day 1 environment variables. See documents/API.md section 11 for the full
# list of variables introduced in later phases (Better Auth, R2, PostHog,
# email, payments) — do not add them here until those integrations land.

# Public Convex deployment URL used by the browser/Next.js client.
# Populated automatically by `npx convex dev` into .env.local; set manually
# for Cloudflare Worker environments (dev/staging/production are separate
# Convex deployments, per ARCHITECTURE.md section 3).
NEXT_PUBLIC_CONVEX_URL=

# Convex CLI deployment identifier, written by `npx convex dev` /
# `npx convex deploy`. Not read by application code directly.
CONVEX_DEPLOYMENT=
