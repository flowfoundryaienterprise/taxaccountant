# Asset caching rules for the Cloudflare Workers static assets.
#
# IMPORTANT: this file REPLACES the `_headers` vinext would otherwise
# generate — it does not merge with it. The `/_next/static/*` rule below is
# vinext's own, reproduced verbatim, and must be kept: those filenames are
# content-hashed, so a changed file gets a new URL and `immutable` is safe.
# Dropping it would make every hashed JS and CSS chunk revalidate on each
# visit, which costs far more than the image caching below gains.
#
# Verify after a dependency upgrade that this still matches what vinext
# emits (build, then read .cloudflare/output/.../assets/_headers).

# Cache content-hashed assets immutably (generated by vinext)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Static imagery shipped in `public/`. These are served at a stable path
# with no content hash, so they cannot be `immutable` — a replacement keeps
# its URL. A week of caching with revalidation gives repeat visitors a local
# copy while still letting a changed file be picked up.
/images/*
  Cache-Control: public, max-age=604800, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=604800, must-revalidate

/favicon-32.png
  Cache-Control: public, max-age=604800, must-revalidate

/apple-touch-icon.png
  Cache-Control: public, max-age=604800, must-revalidate
